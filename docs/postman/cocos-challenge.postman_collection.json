              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const ypfd = body.positions.find(p => p.ticker === 'YPFD');",
                  "pm.test('YPFD bajó 5 acciones', () => {",
                  "  const afterBuys = Number(pm.collectionVariables.get('ypfdQtyAfterBuys'));",
                  "  pm.expect(ypfd.quantity).to.eql(afterBuys - 5);",
                  "});",
                  "pm.test('El efectivo subió por la venta', () => {",
                  "  const cash = Number(body.availableCash);",
                  "  const expected = Number(pm.collectionVariables.get('cashAfterBuys')) + 5 * Number(pm.collectionVariables.get('sellExecutedPrice'));",
                  "  pm.expect(cash.toFixed(2)).to.eql(expected.toFixed(2));",
                  "});",
                  "pm.collectionVariables.set('cashBeforeCashIn', body.availableCash);"
                ]
