                  "pm.test('Tiene precio de ejecución', () => pm.expect(Number(body.executedPrice)).to.be.greaterThan(0));",
                  "pm.collectionVariables.set('sellExecutedPrice', body.executedPrice);"
                ]
              }
            }
          ],
          "request": {
