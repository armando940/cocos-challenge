    {
      "name": "06 · Cierre (venta y efectivo)",
      "description": "Verifica el impacto de las operaciones anteriores con deltas (no con valores absolutos del seed), para que la colección funcione tanto en una base nueva como en la que ya trae el dump legacy.",
      "item": [
        {
          "name": "Portfolio después de las compras",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const before = Number(pm.collectionVariables.get('beforeCash'));",
                  "const after = Number(body.availableCash);",
                  "pm.test('El efectivo bajó', () => pm.expect(after).to.be.below(before));",
                  "pm.test('Débito exacto de las dos compras MARKET', () => {",
                  "  const delta = (before - after).toFixed(2);",
                  "  const ypfdCost = 10 * Number(pm.collectionVariables.get('ypfdExecutedPrice'));",
                  "  const pampCost = Number(pm.collectionVariables.get('altExecutedSize')) * Number(pm.collectionVariables.get('altExecutedPrice'));",
                  "  pm.expect(delta).to.eql((ypfdCost + pampCost).toFixed(2));",
                  "});",
                  "const ypfd = body.positions.find(p => p.ticker === 'YPFD');",
                  "const pamp = body.positions.find(p => p.ticker === 'PAMP');",
                  "pm.test('YPFD tiene 10 acciones más', () => {",
                  "  const beforeQty = Number(pm.collectionVariables.get('ypfdQtyBefore'));",
                  "  pm.expect(ypfd.quantity).to.eql(beforeQty + 10);",
                  "});",
                  "pm.test('PAMP tiene las acciones compradas de más', () => {",
                  "  const beforeQty = Number(pm.collectionVariables.get('pampQtyBefore'));",
                  "  pm.expect(pamp.quantity).to.eql(beforeQty + Number(pm.collectionVariables.get('altExecutedSize')));",
                  "});",
                  "pm.collectionVariables.set('ypfdQtyAfterBuys', ypfd.quantity);",
                  "pm.collectionVariables.set('cashAfterBuys', body.availableCash);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/portfolio/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "portfolio", "{{userId}}"]
            }
          }
        },
