            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"instrumentId\": {{ggalId}},\n  \"side\": \"SELL\",\n  \"type\": \"MARKET\",\n  \"size\": 999,\n  \"idempotencyKey\": \"{{$guid}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        },
        {
