    {
      "name": "02 · Portfolio (estado inicial)",
      "item": [
        {
          "name": "Portfolio inicial (user 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('userId correcto', () => pm.expect(body.userId).to.eql(Number(pm.environment.get('userId'))));",
                  "pm.test('availableCash es string', () => pm.expect(body.availableCash).to.be.a('string'));",
                  "pm.test('totalAccountValue es string', () => pm.expect(body.totalAccountValue).to.be.a('string'));",
                  "pm.test('positions es un array', () => pm.expect(body.positions).to.be.an('array'));",
                  "pm.test('Tiene saldo para operar', () => pm.expect(Number(body.availableCash)).to.be.greaterThan(0));",
                  "const ypfd = body.positions.find(p => p.ticker === 'YPFD');",
                  "const pamp = body.positions.find(p => p.ticker === 'PAMP');",
                  "pm.collectionVariables.set('beforeCash', body.availableCash);",
                  "pm.collectionVariables.set('ypfdQtyBefore', ypfd ? ypfd.quantity : 0);",
                  "pm.collectionVariables.set('pampQtyBefore', pamp ? pamp.quantity : 0);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/portfolio/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "portfolio", "{{userId}}"]
            }
          }
        },
