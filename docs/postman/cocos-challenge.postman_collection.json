    {
      "name": "04 · Órdenes (camino feliz)",
      "description": "Cada request genera una idempotencyKey nueva (salvo los reintentos), así la colección se puede volver a correr sin reutilizar respuestas cacheadas.",
      "item": [
        {
          "name": "MARKET BUY por size (YPFD 10)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('marketKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Queda FILLED', () => pm.expect(body.status).to.eql('FILLED'));",
                  "pm.test('Ejecuta 10 acciones', () => pm.expect(body.executedSize).to.eql(10));",
                  "pm.test('Tiene precio de ejecución', () => pm.expect(Number(body.executedPrice)).to.be.greaterThan(0));",
                  "pm.test('Devuelve orderId', () => pm.expect(body.orderId).to.be.a('number'));",
                  "pm.collectionVariables.set('marketOrderId', body.orderId);",
                  "pm.collectionVariables.set('marketOrderDatetime', body.datetime);",
                  "pm.collectionVariables.set('ypfdExecutedPrice', body.executedPrice);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"instrumentId\": {{ypfdId}},\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"size\": 10,\n  \"idempotencyKey\": \"{{marketKey}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        },
        {
          "name": "Reintento idéntico (idempotencia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve la MISMA orden', () => {",
                  "  pm.expect(body.orderId).to.eql(pm.collectionVariables.get('marketOrderId'));",
                  "});",
                  "pm.test('Mismo datetime (no se re-ejecutó)', () => {",
                  "  pm.expect(body.datetime).to.eql(pm.collectionVariables.get('marketOrderDatetime'));",
                  "});",
                  "pm.test('Sigue FILLED', () => pm.expect(body.status).to.eql('FILLED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"instrumentId\": {{ypfdId}},\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"size\": 10,\n  \"idempotencyKey\": \"{{marketKey}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        },
        {
          "name": "Misma key, request distinto (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('Título de conflicto', () => pm.expect(body.title).to.eql('Conflicto de idempotencia'));",
                  "pm.test('Reporta la key en properties', () => {",
                  "  pm.expect(body.properties.key).to.eql(pm.collectionVariables.get('marketKey'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"instrumentId\": {{ypfdId}},\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"size\": 11,\n  \"idempotencyKey\": \"{{marketKey}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        },
        {
          "name": "MARKET BUY por amount (PAMP $50.000)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Queda FILLED', () => pm.expect(body.status).to.eql('FILLED'));",
                  "pm.test('Calcula acciones enteras (floor)', () => {",
                  "  const expected = Math.floor(50000 / Number(body.executedPrice));",
                  "  pm.expect(body.executedSize).to.eql(expected);",
                  "});",
                  "pm.test('No gasta más que el monto', () => {",
                  "  pm.expect(Number(body.executedPrice) * body.executedSize).to.be.at.most(50000);",
                  "});",
                  "pm.collectionVariables.set('altExecutedSize', body.executedSize);",
                  "pm.collectionVariables.set('altExecutedPrice', body.executedPrice);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"instrumentId\": {{pampId}},\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"amount\": 50000,\n  \"idempotencyKey\": \"{{$guid}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        },
        {
          "name": "LIMIT BUY → NEW",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const price = Number(pm.collectionVariables.get('ggalPrice'));",
                  "if (!price) { throw new Error('Falta ggalPrice: ejecutá primero la carpeta 00 · Preparación'); }",
                  "pm.collectionVariables.set('limitPrice', (price * 0.5).toFixed(2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Queda NEW (no se ejecuta)', () => pm.expect(body.status).to.eql('NEW'));",
                  "pm.test('Sin precio de ejecución', () => pm.expect(body.executedPrice).to.be.null);",
                  "pm.test('Sin cantidad ejecutada', () => pm.expect(body.executedSize).to.be.null);",
                  "pm.collectionVariables.set('limitOrderId', body.orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"instrumentId\": {{ggalId}},\n  \"side\": \"BUY\",\n  \"type\": \"LIMIT\",\n  \"price\": {{limitPrice}},\n  \"size\": 5,\n  \"idempotencyKey\": \"{{$guid}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
